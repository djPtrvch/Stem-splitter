{
  "name": "Stem Splitter",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  // установка зависимостей; ошибки не ломают создание Codespace (повтор при старте)
  "onCreateCommand": "bash .devcontainer/setup.sh || true",
  // при каждом пробуждении: доустановить недостающее и запустить сервер в фоне
  "postStartCommand": "bash .devcontainer/start.sh || true",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": { "label": "Stem Splitter", "onAutoForward": "openBrowser" }
  },
  "customizations": {
    "codespaces": { "openFiles": [".devcontainer/HOWTO.md"] }
  }
}
